server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'; connect-src 'self'" always;

    # Re-resolve the API's name: on Railway its private address changes with every deploy.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # Same-origin API: the browser never needs CORS or to know where the API lives.
    location /v1/ {
        set $api ${API_HOST}:8000;
        proxy_pass http://$api;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 120s;
    }

    # `expires` rather than `add_header`, which would drop the security headers above.
    location /assets/ {
        expires max;
        try_files $uri =404;
    }

    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
