{
  "name": "Release Radar",
  "dockerComposeFile": ["../docker-compose.yml", "compose.devcontainer.yml"],
  "service": "dev",
  "runServices": ["db", "dev"],
  "workspaceFolder": "/workspaces/release-radar",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22", "pnpmVersion": "10.33.4" }
  },
  "containerEnv": {
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv",
    "UV_LINK_MODE": "copy"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "API" },
    "5173": { "label": "Dashboard", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "oxc.oxc-vscode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
        "[typescript][typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "editor.formatOnSave": true
      }
    }
  }
}
