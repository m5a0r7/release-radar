# Copy to .env and fill in. Never commit .env.

# Optional but recommended: a GitHub token with no scopes (public data only) raises the
# rate limit from 60 to 5,000 requests/hour. https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# LLM narrative. "template" needs no key and produces a deterministic, evidence-only summary.
LLM_PROVIDER=template
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# How far back the first GitHub sync goes.
GITHUB_BACKFILL_DAYS=120

# Where the browser opens the app. The GitHub OAuth callback is APP_BASE_URL/v1/auth/github/callback.
# Use http://localhost:5173 with `make web`.
APP_BASE_URL=http://localhost:8080

# "Sign in with GitHub": create an OAuth app at https://github.com/settings/developers with the
# callback above. Leave both blank to offer only the demo sign-in.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# One-click shared demo account. Refused when ENVIRONMENT=production.
AUTH_DEV_LOGIN=true
# Set to true when serving over HTTPS.
SESSION_COOKIE_SECURE=false

# Tracked, unreleased releases are re-synced in the background this often.
AUTO_SYNC_HOURS=6

# Only needed when running outside docker compose.
# DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5432/radar
